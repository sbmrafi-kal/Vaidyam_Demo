{% comment %}
  vaidyam-article-hero.liquid — Individual article hero layout
{% endcomment %}

{%- liquid
  assign hero_article = article
  assign hero_sec = hero_article.metafields.custom.hero_section.value
  assign default_dek = 'A comprehensive clinical review on the synergy of Amalaki, Haritaki, and Bibhitaki — examining Rasapanchaka, microbiome modulation, Srotoshodhana, and CARE-compliant case evidence for practicing vaidyas.'
  assign dek = hero_sec.dek.value | default: hero_sec.dek | default: hero_sec.short_summary.value | default: hero_sec.short_summary | default: block.settings.dek | default: default_dek | strip_html
  assign display_read_time = '12 min read'
  assign hero_image = block.settings.image | default: hero_article.image
-%}

<article class="vaidyam-article-hero" aria-label="Article introduction">
  <div class="vaidyam-article-hero__content">
    <div class="vaidyam-article-hero__copy">
      <p class="vaidyam-eyebrow" style="margin-bottom: 12px;">CLINICAL AYURVEDA · VOL VIII ISSUE 4</p>
      {%- assign hero_title = hero_article.title | default: 'Triphala in Clinical Practice: A Multidisciplinary Review on Gut Health, Metabolic Modulation and Srotas Purification' -%}
      {%- if hero_title == 'Ayurveda' or hero_title == blank -%}
        {%- assign hero_title = 'Triphala in Clinical Practice: A Multidisciplinary Review on Gut Health, Metabolic Modulation and Srotas Purification' -%}
      {%- endif -%}
      <h1 style="font-family: 'Amstir', Georgia, serif; font-size: clamp(28px, 4vw, 44px); color: #1B4332; line-height: 1.25; margin-bottom: 16px;">{{ hero_title }}</h1>

      {%- if dek != blank -%}
        <p class="vaidyam-article-hero__dek" style="font-size: 17px; color: #4A5568; line-height: 1.6; margin-bottom: 24px;">{{ dek }}</p>
      {%- endif -%}

      <div class="ka-article-dates-share">
        <div class="ka-article-dates">
          <span class="ka-hero-meta-item"><span class="kal-article-hero__date-label">Published:</span> <b>October 2025</b></span>
          <span class="ka-article-date-sep">|</span>
          <span class="ka-hero-meta-item"><span class="kal-article-hero__date-label">Peer-Reviewed:</span> <b>Editorial Board</b></span>
          <span class="ka-article-date-sep">|</span>
          <span class="ka-article-read-time ka-read-time-inline">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <b>{{ display_read_time }}</b>
          </span>
        </div>
        <div class="ka-article-share">
          <span>Share</span>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url }}{{ hero_article.url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="https://api.whatsapp.com/send?text={{ hero_title | url_encode }}%20{{ shop.url }}{{ hero_article.url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
