{%- liquid
  assign author_name = author_profile.name.value | default: author_profile.name | default: 'Dr. Nimin Sreedhar'
  assign author_degree = author_profile.degree.value | default: author_profile.degree | default: 'BAMS, MD (Ay.)'
  assign author_designation = author_profile.designation.value | default: author_profile.designation | default: 'Chief of Medical Technology & Consultant, Kerala Ayurveda Limited'
  assign author_bio = 'Specialist in clinical pharmacology, pharmacognosy, and protocol formulation with over 14 years of integrative clinical experience.'

  assign reviewer_name = reviewer_profile.name.value | default: reviewer_profile.name | default: 'Dr. M. R. Vasudevan Nampoothiri'
  assign reviewer_degree = reviewer_profile.degree.value | default: reviewer_profile.degree | default: 'MD (Ay.), PhD'
  assign reviewer_designation = reviewer_profile.designation.value | default: reviewer_profile.designation | default: 'Former Director of Ayurveda Medical Education, Govt. of Kerala'
  assign reviewer_bio = 'Doyen of clinical Ayurveda and academic research; Senior Patron of Vaidyam Journal.'
-%}

<div class="ka-author-reviewer-component" style="margin: 36px 0;">
  <div class="ka-expert-section-container reveal-on-scroll" style="background: #FAF8F2; border: 1px solid #ECE4D0; border-radius: 16px; padding: 28px;">
    <h3 style="font-family: 'Amstir', serif; font-size: 20px; color: #1B4332; margin-bottom: 20px; border-bottom: 1px solid #E2D7BE; padding-bottom: 10px;">Peer-Reviewed Clinical Authorship</h3>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
      <div style="background: #FFFFFF; border: 1px solid #EFE9DB; border-radius: 12px; padding: 20px;">
        <span style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: #C9A84C; letter-spacing: 0.08em;">PRIMARY AUTHOR</span>
        <h4 style="font-family: 'Amstir', serif; font-size: 18px; color: #1B4332; margin: 6px 0 4px;">{{ author_name }}</h4>
        <p style="font-size: 13px; font-weight: 700; color: #2D6A4F; margin: 0 0 6px;">{{ author_degree }}</p>
        <p style="font-size: 12px; color: #666; margin: 0 0 8px;">{{ author_designation }}</p>
        <p style="font-size: 13px; color: #444; line-height: 1.5; margin: 0;">{{ author_bio }}</p>
      </div>
      <div style="background: #FFFFFF; border: 1px solid #EFE9DB; border-radius: 12px; padding: 20px;">
        <span style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: #C9A84C; letter-spacing: 0.08em;">PEER REVIEWER & PATRON</span>
        <h4 style="font-family: 'Amstir', serif; font-size: 18px; color: #1B4332; margin: 6px 0 4px;">{{ reviewer_name }}</h4>
        <p style="font-size: 13px; font-weight: 700; color: #2D6A4F; margin: 0 0 6px;">{{ reviewer_degree }}</p>
        <p style="font-size: 12px; color: #666; margin: 0 0 8px;">{{ reviewer_designation }}</p>
        <p style="font-size: 13px; color: #444; line-height: 1.5; margin: 0;">{{ reviewer_bio }}</p>
      </div>
    </div>
  </div>
</div>
