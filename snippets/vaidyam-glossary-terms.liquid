{% comment %}
  vaidyam-glossary-terms.liquid — Glossary grid from metaobjects (meta-driven)
  Usage: {% render 'vaidyam-glossary-terms', article: article, blog: blog %}
{% endcomment %}

{%- liquid
  assign glossary_sec = article.metafields.custom.glossary_section.value | default: article.metafields.custom.glossary_section
  assign glossary = glossary_sec.glossary_terms.value | default: glossary_sec.glossary_terms | default: article.metafields.custom.glossary_terms.value
  assign glossary_heading = block.settings.heading | default: glossary_sec.glossary_heading.value | default: glossary_sec.glossary_heading | default: blog.metafields.custom.glossary_heading | default: 'Ayurveda Glossary'
-%}

{%- if glossary != blank and glossary.size > 0 -%}
  <section class="ka-article-glossary-card ka-glossary-section ka-section-spaced" id="glossary">
<script src="{{ 'vaidyam-glossary-terms.js' | asset_url }}" defer></script>

<script id="ka-glossary-data" type="application/json">
[
  {%- for term in glossary -%}
    {%- assign term_title = term.term.value | default: term.term -%}
    {%- assign term_def = term.short_definition.value | default: term.short_definition | default: term.definition -%}
    {%- assign term_sec = term.secondary_term.value | default: term.secondary_term -%}
    {%- assign term_pron = term.pronunciation.value | default: term.pronunciation -%}
    {
      "term": {{ term_title | json }},
      "short_definition": {{ term_def | json }},
      "secondary_term": {{ term_sec | json }},
      "pronunciation": {{ term_pron | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

    <div class="ka-glossary-header">
      <div class="ka-glossary-header-content">
        <h2>{{ glossary_heading }}</h2>
      </div>
      <button class="ka-glossary-toggle-btn" type="button" aria-label="Toggle Glossary" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ka-glossary-svg-icon">
          <line x1="12" y1="5" x2="12" y2="19" class="ka-glossary-plus-line"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>
    
    <div class="ka-article-glossary-grid-wrapper">
      <div class="ka-article-glossary-grid">
        {%- for term in glossary -%}
          <div class="ka-glossary-item-row">
            <b class="ka-glossary-term-title">{{ term.term }}</b>
            {%- if term.secondary_term != blank or term.pronunciation != blank -%}
              <div class="ka-glossary-meta-line">
                {%- if term.secondary_term != blank -%}
                  <span class="ka-blog-muted ka-glossary-secondary">({{ term.secondary_term }})</span>
                {%- endif -%}
                {%- if term.pronunciation != blank -%}
                  <span class="ka-blog-muted ka-glossary-pronunciation">{{ term.pronunciation }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if term.short_definition != blank -%}
              <p class="ka-blog-muted ka-glossary-def">{{ term.short_definition }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

  </section>
{%- endif -%}
