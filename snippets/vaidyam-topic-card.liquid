{% comment %}
  vaidyam-topic-card.liquid — Full-image topic card with robust fallback & asset image support
  Usage: {% render 'vaidyam-topic-card', topic: topic, blog: blog, index: index, fallback_title: fallback_title, fallback_image: fallback_image, fallback_tag: fallback_tag %}
{% endcomment %}

{%- liquid
  assign topic_title = topic.title.value | default: topic.title | default: fallback_title
  assign topic_tag = topic.article_filter_tag.value | default: topic.article_filter_tag | default: fallback_tag | default: topic_title
  assign topic_handle = topic.system.handle | default: topic.handle | default: topic_tag | handleize
  assign topic_count_label = topic.cta_label.value | default: topic.cta_label | default: 'Explore domain'

  assign target_url = '/blogs/ayurveda/tagged/' | append: topic_handle
  if blog != blank and blog.url != blank
    assign target_url = blog.url | append: '/tagged/' | append: topic_handle | append: '?topic=' | append: topic_handle
  endif

  assign img_file = topic.image.value | default: topic.image | default: fallback_image
  if img_file != blank
    if img_file contains '.png' or img_file contains '.jpg' or img_file contains '.webp'
      assign topic_img_url = img_file | asset_url
    else
      assign topic_img_url = img_file | image_url: width: 600
    endif
  else
    assign topic_img_url = ''
  endif
-%}

{%- if topic_title != blank -%}
  <a class="ka-blog-image-card" href="{{ target_url }}" data-topic="{{ topic_handle }}">
    {%- if topic_img_url != blank -%}
      <img class="ka-blog-image-card__bg" src="{{ topic_img_url }}" alt="{{ topic_title | escape }}" loading="lazy" width="600" height="400">
    {%- else -%}
      <div class="ka-blog-image-card__gradient-bg"></div>
    {%- endif -%}
    <div class="ka-blog-image-card__overlay" aria-hidden="true"></div>
    <div class="ka-blog-image-card__content">
      <h3>{{ topic_title }}</h3>
      <span class="ka-blog-read-more">{{ topic_count_label }} &rarr;</span>
    </div>
  </a>
{%- endif -%}
