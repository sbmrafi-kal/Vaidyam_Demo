{%- render 'vaidyam-font' -%}
{{ 'vaidyam-landing.css' | asset_url | stylesheet_tag }}

<div class="vaidyam-static-page">
  <div class="page-width vaidyam-container">
    <div class="vaidyam-static-header">
      <p class="vaidyam-eyebrow">EDITORIAL GOVERNANCE · EXPERTISE</p>
      <h1 class="vaidyam-static-title">Editorial Board &amp; Advisory</h1>
      <p class="vaidyam-static-lead">Guided by doyens of Ayurvedic clinical practice, research scientists, and academic leaders dedicated to advancing evidence-based Ayurveda.</p>
    </div>

    <div class="vaidyam-editorial-container">
      
      <!-- PATRONS -->
      <div class="vaidyam-board-group">
        <h2 class="vaidyam-board-group__title">Patrons</h2>
        <div class="vaidyam-board-grid">
          
          <div class="vaidyam-member-card">
            <div class="vaidyam-member-header">
              <div class="vaidyam-member-avatar">
                <span>RV</span>
              </div>
              <div>
                <h3 class="vaidyam-member-name">Mr. Ramesh Vangal</h3>
                <p class="vaidyam-member-role">Chairman, Kerala Ayurveda Limited</p>
              </div>
            </div>
            <p class="vaidyam-member-bio">Mr. Ramesh Vangal assumed charge as Director of the Company with effect from 24th January 2006. He is an experienced and successful Professional with demonstrated leadership in promoting and growing business. He is the Founder and Chairman of the Scandent Group and Katra Group. Formerly Chairman of Seagram Asia Pacific and President, Asia Pacific for PepsiCo Foods, and a Member of PepsiCo’s Worldwide Executive Council.</p>
            <a href="https://www.linkedin.com/in/rameshvangal/" target="_blank" rel="noopener noreferrer" class="vaidyam-member-linkedin">View LinkedIn Profile &rarr;</a>
          </div>

          <div class="vaidyam-member-card">
            <div class="vaidyam-member-header">
              <div class="vaidyam-member-avatar">
                <span>VN</span>
              </div>
              <div>
                <h3 class="vaidyam-member-name">Dr. M. R. Vasudevan Nampoothiri</h3>
                <p class="vaidyam-member-role">Former Director of Ayurveda Medical Education, Govt. of Kerala</p>
              </div>
            </div>
            <p class="vaidyam-member-bio">Dr. M. R. Vasudevan Nampoothiri is a highly respected Ayurvedic physician and academic with over 40 years of experience. A first-rank graduate from Kottakkal Ayurveda College in 1978, he served as Principal of Govt. Ayurveda College Thiruvananthapuram and retired as Director of Ayurveda Medical Education in 2010. Recipient of the Indian Govt.'s Best Teacher Award (2016) and Kerala Govt.'s Best Doctor Award (2019).</p>
          </div>

        </div>
      </div>

      <!-- EDITORIAL LEADERSHIP -->
      <div class="vaidyam-board-group">
        <h2 class="vaidyam-board-group__title">Editorial Leadership</h2>
        <div class="vaidyam-board-grid">

          <div class="vaidyam-member-card">
            <div class="vaidyam-member-header">
              <div class="vaidyam-member-avatar">
                <span>AK</span>
              </div>
              <div>
                <h3 class="vaidyam-member-name">Dr. K. Anilkumar</h3>
                <p class="vaidyam-member-role">Managing Editor · Executive Director, Kerala Ayurveda Limited</p>
              </div>
            </div>
            <p class="vaidyam-member-bio">Dr. K. Anil Kumar, an eminent Ayurvedic Practitioner from Kerala, is the Executive Director of Kerala Ayurveda Limited. He is an Elected Member on the Central Council of Indian Medicine (CCIM) – the Apex Body of the Govt. of India for Indian Systems of Medicine. Past President of the Ayurvedic Medical Association of India and Executive Member of AMMOI.</p>
            <a href="https://www.linkedin.com/in/dr-k-anilkumar-kunju-panicker-96979098/" target="_blank" rel="noopener noreferrer" class="vaidyam-member-linkedin">View LinkedIn Profile &rarr;</a>
          </div>

          <div class="vaidyam-member-card">
            <div class="vaidyam-member-header">
              <div class="vaidyam-member-avatar">
                <span>SN</span>
              </div>
              <div>
                <h3 class="vaidyam-member-name">Dr. Sreevaths N. V.</h3>
                <p class="vaidyam-member-role">Chief Editor · Chief Physician, Svasthyakshetram</p>
              </div>
            </div>
            <p class="vaidyam-member-bio">Dr. N.V. Sreevaths is a highly experienced Ayurvedic doctor and Marma specialist (B.A.M.S., M.D. in Salyatantra and Marma Chikitsa). Former Principal of Ayurveda College Coimbatore and Professor at Santhigiri Ayurveda Medical College. He has formulated over 20 unique herbal combinations and developed specialized massage oils.</p>
          </div>

        </div>
      </div>

      <!-- EDITORIAL ADVISORS -->
      <div class="vaidyam-board-group">
        <h2 class="vaidyam-board-group__title">Editorial Advisors</h2>
        <div class="vaidyam-advisors-grid">

          <div class="vaidyam-advisor-card">
            <h4>Dr. K. Jayarajan</h4>
            <p class="vaidyam-advisor-role">CEO &amp; Academy Director, Kerala Ayurveda USA</p>
            <p class="vaidyam-advisor-bio">Internationally acclaimed Ayurvedic scholar and author with over 25 years of clinical expertise across India and the US, and Board Member of NAMA.</p>
            <a href="https://www.linkedin.com/in/drkjayarajan/" target="_blank" rel="noopener noreferrer" class="vaidyam-member-linkedin">LinkedIn &rarr;</a>
          </div>

          <div class="vaidyam-advisor-card">
            <h4>Dr. Sarala Samuel</h4>
            <p class="vaidyam-advisor-role">General Manager (R&amp;D), Kerala Ayurveda Limited</p>
            <p class="vaidyam-advisor-bio">Leading botanist and pharmacognosy expert specializing in bioactivity and medicinal plant standardization integrating classical wisdom with modern research.</p>
            <a href="https://www.linkedin.com/in/sarala-samuel-336138108/" target="_blank" rel="noopener noreferrer" class="vaidyam-member-linkedin">LinkedIn &rarr;</a>
          </div>

          <div class="vaidyam-advisor-card">
            <h4>Dr. Sadath D. R.</h4>
            <p class="vaidyam-advisor-role">Chief Physician, Kerala Ayurveda Wellness Clinic Ernakulam</p>
            <p class="vaidyam-advisor-bio">Over 20 years in Ayurvedic clinical practice, former State Committee General Secretary for AMAI Kerala.</p>
            <a href="https://www.linkedin.com/in/dr-sadath-dinakar-b9051527/" target="_blank" rel="noopener noreferrer" class="vaidyam-member-linkedin">LinkedIn &rarr;</a>
          </div>

          <div class="vaidyam-advisor-card">
            <h4>Dr. Sreeraj I. P.</h4>
            <p class="vaidyam-advisor-role">Medical Superintendent, Kerala Ayurveda Hospital Kasaragod</p>
            <p class="vaidyam-advisor-bio">Distinguished clinical physician with over 25 years of service at Kerala Ayurveda leading inpatient hospital care.</p>
            <a href="https://www.linkedin.com/in/dr-sreeraj-i-p-b06b39352/" target="_blank" rel="noopener noreferrer" class="vaidyam-member-linkedin">LinkedIn &rarr;</a>
          </div>

          <div class="vaidyam-advisor-card">
            <h4>Mr. Vivek Sunder</h4>
            <p class="vaidyam-advisor-role">CEO, Kerala Ayurveda Limited</p>
            <p class="vaidyam-advisor-bio">IIM Calcutta alumnus driving traditional Ayurveda globally through digital transformation, previously leadership at Swiggy, P&amp;G, and Cuemath.</p>
            <a href="https://www.linkedin.com/in/viveksunder/" target="_blank" rel="noopener noreferrer" class="vaidyam-member-linkedin">LinkedIn &rarr;</a>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<style>
.vaidyam-editorial-container {
  max-width: 1040px;
  margin: 0 auto;
}
.vaidyam-board-group {
  margin-bottom: 56px;
}
.vaidyam-board-group__title {
  font-family: 'Amstir', Georgia, serif;
  font-size: 26px;
  font-weight: 700;
  color: #1B4332;
  margin-bottom: 24px;
  border-bottom: 2px solid #EAE5D9;
  padding-bottom: 10px;
}
.vaidyam-board-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
}
.vaidyam-member-card {
  background: #FAF8F4;
  border: 1px solid #ECE7DB;
  border-radius: 16px;
  padding: 32px;
  display: flex;
  flex-direction: column;
}
.vaidyam-member-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 16px;
}
.vaidyam-member-avatar {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: #1B4332;
  color: #E4C264;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Amstir', Georgia, serif;
  font-weight: 700;
  font-size: 18px;
  flex-shrink: 0;
}
.vaidyam-member-name {
  font-family: 'Amstir', Georgia, serif;
  font-size: 20px;
  font-weight: 700;
  color: #1B4332;
  margin: 0 0 4px 0;
}
.vaidyam-member-role {
  font-size: 13px;
  font-weight: 600;
  color: #2D6A4F;
  margin: 0;
}
.vaidyam-member-bio {
  font-size: 14.5px;
  color: #555;
  line-height: 1.6;
  margin: 0 0 16px 0;
  flex-grow: 1;
}
.vaidyam-member-linkedin {
  font-size: 13.5px;
  font-weight: 600;
  color: #1B4332;
  text-decoration: none;
}
.vaidyam-member-linkedin:hover {
  color: #2D6A4F;
  text-decoration: underline;
}
.vaidyam-advisors-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.vaidyam-advisor-card {
  background: #F4F8F5;
  border-radius: 12px;
  padding: 24px;
  border-left: 3px solid #1B4332;
  display: flex;
  flex-direction: column;
}
.vaidyam-advisor-card h4 {
  font-family: 'Amstir', Georgia, serif;
  font-size: 18px;
  font-weight: 700;
  color: #1B4332;
  margin: 0 0 4px 0;
}
.vaidyam-advisor-role {
  font-size: 12px;
  font-weight: 600;
  color: #2D6A4F;
  margin: 0 0 10px 0;
}
.vaidyam-advisor-bio {
  font-size: 13.5px;
  color: #555;
  line-height: 1.5;
  margin: 0 0 12px 0;
  flex-grow: 1;
}
@media (max-width: 860px) {
  .vaidyam-board-grid, .vaidyam-advisors-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Editorial Board",
  "settings": []
}
{% endschema %}
