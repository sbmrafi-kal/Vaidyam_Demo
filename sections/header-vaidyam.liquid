{% comment %}
  sections/header-vaidyam.liquid — Masthead & Brand Header
  BEM Structure: .v-masthead
{% endcomment %}

{{ 'vaidyam-header.css' | asset_url | stylesheet_tag }}

<header class="v-masthead" role="banner">
  <!-- Top Metadata Ledger -->
  <div class="v-masthead__ledger">
    <div class="page-width vaidyam-container">
      <div class="v-masthead__ledger-row">
        <div class="v-masthead__ledger-left">
          <span class="v-masthead__issn-pill">ISSN 2394-4323</span>
          <span class="v-masthead__dot">•</span>
          <span class="v-masthead__ledger-text">QUARTERLY PRINT &amp; DIGITAL MEDICAL JOURNAL</span>
          <span class="v-masthead__dot v-masthead__dot--hide-mobile">•</span>
          <span class="v-masthead__ledger-text v-masthead__ledger-text--hide-mobile">VOL. VIII • ISSUE 4</span>
        </div>
        <div class="v-masthead__ledger-right">
          <span class="v-masthead__care-badge">ICMJE &amp; CARE-STANDARD AUDITED</span>
          <a href="#author-guidelines" class="v-masthead__submit-link">MANUSCRIPT POLICIES ➔</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="v-masthead__main">
    <div class="page-width vaidyam-container">
      <div class="v-masthead__main-row">
        
        <!-- Brand Title -->
        <a href="{{ routes.root_url }}" class="v-masthead__brand">
          <span class="v-masthead__brand-title">VAIDYAM</span>
          <span class="v-masthead__brand-sub">A Journal on Evolving Ayurveda • Estd. 2003</span>
        </a>

        <!-- Academic Nav Links -->
        <nav class="v-masthead__nav" aria-label="Journal Navigation">
          <a href="#philosophy" class="v-masthead__nav-link">Philosophy</a>
          <a href="#departments" class="v-masthead__nav-link">18 Columns</a>
          <a href="#care-pathways" class="v-masthead__nav-link">Care Pathways</a>
          <a href="#care-report" class="v-masthead__nav-link">CARE Case Study</a>
          <a href="#archival-museum" class="v-masthead__nav-link">Archives (1997–2026)</a>
          <a href="#editorial-board" class="v-masthead__nav-link">Editorial Board</a>
        </nav>

        <!-- CTA Subscribe Button -->
        <div class="v-masthead__actions">
          <a href="#subscribe-plan" class="v-masthead__btn-subscribe">
            Subscribe (₹1,200/yr)
          </a>
          <button class="v-masthead__mobile-toggle" type="button" aria-label="Toggle menu" onclick="toggleMobileNav('vaidyam-mobile-nav')">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Nav -->
  <div class="v-masthead__mobile-nav" id="vaidyam-mobile-nav">
    <div class="v-masthead__mobile-nav-inner">
      <a href="#philosophy" onclick="toggleMobileNav('vaidyam-mobile-nav')">Philosophy</a>
      <a href="#departments" onclick="toggleMobileNav('vaidyam-mobile-nav')">18 Columns</a>
      <a href="#care-pathways" onclick="toggleMobileNav('vaidyam-mobile-nav')">Care Pathways</a>
      <a href="#care-report" onclick="toggleMobileNav('vaidyam-mobile-nav')">CARE Case Study</a>
      <a href="#archival-museum" onclick="toggleMobileNav('vaidyam-mobile-nav')">Archives (1997–2026)</a>
      <a href="#editorial-board" onclick="toggleMobileNav('vaidyam-mobile-nav')">Editorial Board</a>
      <a href="#author-guidelines" onclick="toggleMobileNav('vaidyam-mobile-nav')">Manuscript Policies</a>
      <a href="#subscribe-plan" class="v-masthead__mobile-sub-btn" onclick="toggleMobileNav('vaidyam-mobile-nav')">Subscribe (₹1,200/yr)</a>
    </div>
  </div>
</header>

<script src="{{ 'vaidyam-landing.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Academic Journal Header",
  "settings": []
}
{% endschema %}
