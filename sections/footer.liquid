{% comment %}
  sections/footer.liquid — High-End Editorial Publishing Footer
  Features:
  - Brand Masthead: Vaidyam Publication Division, Aluva, Kerala | ISSN: 2394-4323
  - Author Guidelines & Policies (Review Articles, CARE format, Student Innovations, IAST Sanskrit)
  - Official Channels & Quarterly Dispatch Newsletter
  - Bottom Bar with ICMJE, CARE & Vancouver Publishing Guidelines
{% endcomment %}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="vaidyam-journal-footer" id="author-guidelines">
  <div class="page-width vaidyam-container">
    
    <!-- Top Grid -->
    <div class="vaidyam-footer-main-grid">
      
      <!-- Brand Masthead (4 Cols) -->
      <div class="footer-col brand-mission-col">
        <div class="footer-brand-wrap">
          <span class="footer-brand-title">VAIDYAM</span>
          <span class="footer-brand-tag">A Journal on Evolving Ayurveda • Estd. 2003</span>
        </div>
        <p class="footer-mission-desc">
          Kerala Ayurveda Vaidyam is a pioneering quarterly publication committed to classical textual interpretation, CARE-compliant clinical observations, and med-tech innovation.
        </p>
        <div class="footer-office-meta">
          <p><strong>ISSN:</strong> 2394-4323 (Print &amp; Digital)</p>
          <p><strong>Editorial Office:</strong> Publication Division, Athani Post, Aluva, Ernakulam District, Kerala – 683585, India</p>
        </div>
      </div>

      <!-- Author Guidelines & Policies (4 Cols) -->
      <div class="footer-col guidelines-col">
        <h4 class="footer-col-heading">Author Guidelines &amp; Policies</h4>
        <ul class="footer-guidelines-list">
          <li>✦ <strong>Review Articles:</strong> &lt;1,500 words with minimum 5 Vancouver citations</li>
          <li>✦ <strong>Clinical Cases:</strong> Strict international CARE format (&lt;1,500 words)</li>
          <li>✦ <strong>Student Innovations:</strong> &lt;800 words campus reviews &amp; reflections</li>
          <li>✦ <strong>Sanskrit Style:</strong> IAST transliteration, italicized non-proper nouns</li>
          <li>✦ <strong>Direct Submissions:</strong> <a href="mailto:vaidyam@keralaayurveda.biz" class="footer-gold-link">vaidyam@keralaayurveda.biz</a></li>
        </ul>
      </div>

      <!-- Official Channels & Newsletter (4 Cols) -->
      <div class="footer-col channels-col">
        <h4 class="footer-col-heading">Official Channels &amp; Outreach</h4>
        <ul class="footer-channels-list">
          <li>➔ <a href="https://dravya.app" target="_blank" rel="noopener">Dravya App Knowledge Platform</a></li>
          <li>➔ <a href="https://spotify.com" target="_blank" rel="noopener">Spotify: Kerala Ayurveda Podcast</a></li>
          <li>➔ <a href="https://youtube.com/@KALVaidyam" target="_blank" rel="noopener">YouTube: @KALVaidyam Dialogues</a></li>
          <li>➔ <a href="https://instagram.com/keralaayurvedavaidyam" target="_blank" rel="noopener">Instagram: @keralaayurvedavaidyam</a></li>
          <li>➔ Direct Phone: +91 9048033348</li>
        </ul>

        <div class="footer-newsletter-wrap">
          <span class="newsletter-lbl">Subscribe to Quarterly Digital Table of Contents:</span>
          <form onsubmit="event.preventDefault(); alert('Subscribed to Vaidyam Quarterly Dispatch.');" class="newsletter-form">
            <input type="email" placeholder="doctor@hospital.org" required class="newsletter-input">
            <button type="submit" class="newsletter-btn">Join</button>
          </form>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="vaidyam-footer-bottom-bar">
      <span>© 2003–2026 Kerala Ayurveda Limited — Publication Division. All Rights Reserved.</span>
      <span>Indexed under ICMJE, CARE &amp; Vancouver Publishing Guidelines.</span>
    </div>

  </div>
</footer>

