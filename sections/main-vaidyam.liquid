{%- comment -%} theme-check-disable ContentForHeaderModification, UnusedAssign {%- endcomment -%}
{% comment %}
  main-vaidyam.liquid — Vaidyam Magazine Landing Page
  Includes: Hero, About, Current Edition, Care Paths, Topics, Through The Pages, All 18 Sections, By Concern, Video, Testimonials, Legacy, Contact
{% endcomment %}

{%- render 'vaidyam-font' -%}

{{ 'vaidyam-landing.css' | asset_url | stylesheet_tag }}

<div class="vaidyam-landing">

  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'hero' -%}
      {%- comment -%} ============ HERO (SENIOR APPROVED) ============ {%- endcomment -%}
      <section class="vaidyam-hero" id="overview" {{ block.shopify_attributes }}>
        <div class="page-width vaidyam-container">
          <div class="vaidyam-hero__grid">
            <div class="vaidyam-hero__content">
              <p class="vaidyam-eyebrow">{{ section.settings.hero_eyebrow | default: 'KERALA AYURVEDA · SINCE 2003' }}</p>
              <h1 class="vaidyam-hero__title">{{ section.settings.hero_title | default: 'A quarterly journal on evolving Ayurveda, for practitioners and students.' }}</h1>
              <p class="vaidyam-hero__subtitle">{{ section.settings.hero_subtitle | default: 'Vaidyam connects classical Ayurvedic scholarship with contemporary clinical practice — published quarterly by Kerala Ayurveda Limited, reviewed by practicing BAMS and MD physicians.' }}</p>
              
              <div class="vaidyam-hero__actions">
                <a class="vaidyam-btn vaidyam-btn--primary" href="#current-edition">Subscribe to Vaidyam &rarr;</a>
                <a class="vaidyam-btn vaidyam-btn--outline" href="/blogs/ayurveda">Read free articles</a>
              </div>

              <div class="vaidyam-hero__trust">
                <span><strong>80+ years</strong> of Kerala Ayurveda</span>
                <span class="vaidyam-hero__trust-dot">·</span>
                <span><strong>Quarterly since 2003</strong></span>
                <span class="vaidyam-hero__trust-dot">·</span>
                <span>Reviewed by practicing physicians</span>
              </div>
            </div>

            <div class="vaidyam-hero__cover">
              <div class="vaidyam-hero__cover-frame">
                {%- assign cover_image = section.settings.cover_image -%}
                {%- if cover_image != blank -%}
                  {{ cover_image | image_url: width: 600 | image_tag: class: 'vaidyam-hero__cover-img', loading: 'eager', alt: 'Vaidyam Magazine - Current Issue' }}
                {%- else -%}
                  <div class="vaidyam-hero__magazine-card">
                    <div class="vaidyam-magazine-header">
                      <span class="vaidyam-mag-vol">Vol VIII · Issue 4</span>
                      <span class="vaidyam-mag-brand">kerala ayurveda<br><strong>vaidyam</strong></span>
                      <span class="vaidyam-mag-tag">A Journal on Evolving Ayurveda</span>
                    </div>
                    <div class="vaidyam-magazine-artwork">
                      <div class="vaidyam-artwork-visual">
                        <svg viewBox="0 0 100 100" class="vaidyam-artwork-leaf" fill="none">
                          <circle cx="50" cy="50" r="45" stroke="#C9A84C" stroke-width="1.5" stroke-dasharray="3 3"/>
                          <path d="M50 20 C35 35 25 55 50 80 C75 55 65 35 50 20 Z" fill="#2D6A4F" opacity="0.85"/>
                          <path d="M50 20 L50 78" stroke="#E4C264" stroke-width="1.5"/>
                          <path d="M50 35 C42 42 38 48 35 55" stroke="#E4C264" stroke-width="1"/>
                          <path d="M50 45 C58 52 62 58 65 65" stroke="#E4C264" stroke-width="1"/>
                        </svg>
                      </div>
                      <div class="vaidyam-artwork-caption">
                        <span>Thyroid Health &amp; Multidisciplinary Ayurveda</span>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
              <div class="vaidyam-hero__stat-badge">
                <span class="vaidyam-hero__stat-num">18</span>
                <span class="vaidyam-hero__stat-label">recurring sections every issue</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      {%- when 'about' -%}
      {%- comment -%} ============ ABOUT VAIDYAM ============ {%- endcomment -%}
      <section class="vaidyam-about" {{ block.shopify_attributes }}>
        <div class="page-width vaidyam-container">
          <h2 class="vaidyam-section-title">About Kerala Ayurveda Vaidyam</h2>
          <p class="vaidyam-section-subtitle">A quarterly journal on evolving Ayurveda, published by Kerala Ayurveda Limited since 2003 — practitioner-focused, physician-reviewed, and grounded in classical scholarship.</p>
          
          <div class="vaidyam-about__cards">
            <div class="vaidyam-about__card">
              <div class="vaidyam-about__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              </div>
              <h3>Expert Insights</h3>
              <p>Written and reviewed by a real editorial board of practicing BAMS and MD physicians.</p>
            </div>
            
            <div class="vaidyam-about__card">
              <div class="vaidyam-about__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <h3>Curated Diversity</h3>
              <p>Clinical and Foundational content side by side — the Readometer system practitioners and students already rely on.</p>
            </div>
            
            <div class="vaidyam-about__card">
              <div class="vaidyam-about__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </div>
              <h3>Practical Wisdom</h3>
              <p>Practice-ready guidance across 18 recurring sections — Popular Science depth, not academic-journal density.</p>
            </div>
          </div>
        </div>
      </section>

      {%- when 'current_edition' -%}
      {%- comment -%} ============ CURRENT EDITION ============ {%- endcomment -%}
      <section class="vaidyam-current" id="current-edition" {{ block.shopify_attributes }}>
        <div class="page-width vaidyam-container">
          <div class="vaidyam-current__header">
            <h2 class="vaidyam-section-title">Current Edition</h2>
            <p class="vaidyam-section-subtitle">Discover our latest issue filled with expert insights and practical Ayurvedic wisdom.</p>
          </div>
          
          <div class="vaidyam-current__grid">
            <div class="vaidyam-current__cover">
              <span class="vaidyam-current__badge">New Issue</span>
              {%- assign cover_image = section.settings.cover_image -%}
              {%- if cover_image != blank -%}
                {{ cover_image | image_url: width: 600 | image_tag: class: 'vaidyam-current__cover-img', loading: 'lazy', alt: 'Vaidyam Vol VIII Issue 4' }}
              {%- else -%}
                <div class="vaidyam-magazine-edition-card">
                  <div class="vaidyam-mag-top-strip">
                    <span>Vol VIII · Issue 4 · Oct - Dec 2025</span>
                    <span>Published by Kerala Ayurveda Limited</span>
                  </div>
                  <div class="vaidyam-mag-title-bar">
                    <span class="vaidyam-mag-logo-sm">kerala<br>ayurveda</span>
                    <span class="vaidyam-mag-main-title">vaidyam</span>
                    <span class="vaidyam-mag-subtitle">A Journal on Evolving Ayurveda</span>
                  </div>
                  <div class="vaidyam-mag-graphic">
                    <svg viewBox="0 0 160 160" class="vaidyam-mag-center-art">
                      <rect width="160" height="160" fill="#FBF8F2" rx="8"/>
                      <circle cx="80" cy="80" r="65" fill="#EAE2CF" opacity="0.6"/>
                      <path d="M80 30 C55 50 40 85 80 130 C120 85 105 50 80 30 Z" fill="#2D6A4F"/>
                      <path d="M80 30 L80 128" stroke="#E4C264" stroke-width="2"/>
                      <circle cx="80" cy="80" r="15" fill="#C9A84C" opacity="0.8"/>
                    </svg>
                  </div>
                  <div class="vaidyam-mag-bottom-bar">
                    <span>Theme: Multidisciplinary Management of Thyroid Conditions</span>
                  </div>
                </div>
              {%- endif -%}
            </div>
            
            <div class="vaidyam-current__details">
              <p class="vaidyam-current__meta">Vol VIII issue 4, Oct - Dec 2025</p>
              <h2 class="vaidyam-current__title">Vaidyam - A Journal on Evolving Ayurveda</h2>
              
              <div class="vaidyam-current__highlights">
                <p class="vaidyam-current__highlights-title">In This Issue:</p>
                <ul>
                  <li><strong>Special Feature:</strong> Exploring multispeciality approaches in the management of thyroid conditions</li>
                  <li><strong>Futuristic &amp; Thought-Provoking articles:</strong> For the evolution of evidence-based Ayurveda</li>
                  <li><strong>Words of Wisdom:</strong> Insights from doyens of Ayurveda, guiding the next generation of practitioners</li>
                  <li><strong>Clinical Focus:</strong> Practice-oriented, clinically relevant guidance in managing thyroid conditions</li>
                </ul>
              </div>
              
              <div class="vaidyam-current__price">
                <span class="vaidyam-current__price-amount">Rs. 700</span>
                <span class="vaidyam-current__price-note">Print Only · Delivered to your doorstep</span>
              </div>
              
              <div class="vaidyam-current__action-row">
                <a class="vaidyam-btn vaidyam-btn--primary" href="mailto:vaidyam@keralaayurveda.biz?subject=Purchase%20Current%20Edition%20Vol%20VIII%20Issue%204">Get This Issue &rarr;</a>
                <a class="vaidyam-btn vaidyam-btn--outline" href="mailto:vaidyam@keralaayurveda.biz?subject=Annual%20Subscription%20Inquiry">Annual Subscription (₹1200/yr)</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      {%- when 'care_paths' -%}
      {%- comment -%} ============ CARE PATHS (SENIOR APPROVED) ============ {%- endcomment -%}
      <section class="ka-blog-section vaidyam-carepaths-section" id="care-paths" {{ block.shopify_attributes }}>
        <div class="page-width vaidyam-container">
          <div class="ka-blog-section-head">
            <div>
              <p class="ka-blog-eyebrow">CLINICAL PATHWAYS <span class="ka-hindi">· चिकित्सा मार्ग</span></p>
              <h2>Specialized Ayurvedic Care Paths</h2>
            </div>
          </div>

          <div class="ka-blog-care-panel">
            <div class="ka-blog-care-intro">
              <h3>Structured Clinical Pathways for Common Conditions</h3>
              <p class="ka-blog-lead">Each care path integrates classical Ahara (diet), Vihara (lifestyle), and Aushadha (evidence-based formulation) protocols developed by Kerala Ayurveda physicians.</p>
            </div>
            
            <div class="ka-blog-path-list">
              <div class="ka-care-card">
                <div class="ka-care-card__content">
                  <span class="ka-care-card__badge">DIGESTIVE SYSTEM</span>
                  <h4 class="ka-care-card__title">Agni &amp; Gut Health Care Path</h4>
                  <p class="ka-care-card__desc">Protocols for restoring metabolic fire, managing Grahani, IBS, hyperacidity, and chronic constipation.</p>
                  <a href="/blogs/ayurveda" class="ka-care-card__link">
                    <span>Explore Pathway</span>
                    <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
                </div>
              </div>

              <div class="ka-care-card">
                <div class="ka-care-card__content">
                  <span class="ka-care-card__badge">HAIR &amp; SCALP</span>
                  <h4 class="ka-care-card__title">Keshya &amp; Scalp Health Pathway</h4>
                  <p class="ka-care-card__desc">Classical Shiroabhyanga, Neelibhringadi regimens, and root-cause solutions for premature greying and hair thinning.</p>
                  <a href="/blogs/ayurveda" class="ka-care-card__link">
                    <span>Explore Pathway</span>
                    <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
                </div>
              </div>

              <div class="ka-care-card">
                <div class="ka-care-card__content">
                  <span class="ka-care-card__badge">NERVOUS SYSTEM</span>
                  <h4 class="ka-care-card__title">Manas, Stress &amp; Nidra Pathway</h4>
                  <p class="ka-care-card__desc">Medhya Rasayanas, sleep hygiene protocols, and Vata-pacifying therapies for neurological resilience and calm.</p>
                  <a href="/blogs/ayurveda" class="ka-care-card__link">
                    <span>Explore Pathway</span>
                    <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
                </div>
              </div>

              <div class="ka-care-card">
                <div class="ka-care-card__content">
                  <span class="ka-care-card__badge">JOINTS &amp; BONES</span>
                  <h4 class="ka-care-card__title">Sandhi &amp; Asthi Care Pathway</h4>
                  <p class="ka-care-card__desc">Targeted management of Sandhivata, Amavata, spondylosis, and sports-related musculoskeletal strain.</p>
                  <a href="/blogs/ayurveda" class="ka-care-card__link">
                    <span>Explore Pathway</span>
                    <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
                </div>
              </div>

              <div class="ka-care-card">
                <div class="ka-care-card__content">
                  <span class="ka-care-card__badge">METABOLIC HEALTH</span>
                  <h4 class="ka-care-card__title">Thyroid &amp; Endocrine Health</h4>
                  <p class="ka-care-card__desc">Multidisciplinary approaches to Galaganda, Kantha Roga, and metabolic balance through classical formulations.</p>
                  <a href="/blogs/ayurveda" class="ka-care-card__link">
                    <span>Explore Pathway</span>
                    <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
                </div>
              </div>

              <div class="ka-care-card">
                <div class="ka-care-card__content">
                  <span class="ka-care-card__badge">WOMEN'S HEALTH</span>
                  <h4 class="ka-care-card__title">Stree Roga &amp; Hormone Balance</h4>
                  <p class="ka-care-card__desc">Holistic Ayurvedic protocols for PCOS, menstrual irregularities, menopause transition, and postnatal rejuvenation.</p>
                  <a href="/blogs/ayurveda" class="ka-care-card__link">
                    <span>Explore Pathway</span>
                    <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                  </a>
