<script>
  /* Testimonials Carousel */
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.querySelector('.vaidyam-testimonials__carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.vaidyam-testimonials__slide');
    const dots = carousel.querySelectorAll('.vaidyam-testimonials__dot');
    let currentSlide = 0;
    let autoplayTimer;

    function goToSlide(index) {
      if (!slides.length) return;
      slides.forEach(s => s.classList.remove('active'));
      dots.forEach(d => { d.classList.remove('active'); d.setAttribute('aria-selected', 'false'); });
      slides[index].classList.add('active');
      if (dots[index]) {
        dots[index].classList.add('active');
        dots[index].setAttribute('aria-selected', 'true');
      }
      currentSlide = index;
    }

    function nextSlide() {
      goToSlide((currentSlide + 1) % slides.length);
    }

    const prevBtn = carousel.querySelector('.vaidyam-carousel-arrow.prev');
    const nextBtn = carousel.querySelector('.vaidyam-carousel-arrow.next');

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        goToSlide((currentSlide - 1 + slides.length) % slides.length);
        clearInterval(autoplayTimer);
        autoplayTimer = setInterval(nextSlide, 6000);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        nextSlide();
        clearInterval(autoplayTimer);
        autoplayTimer = setInterval(nextSlide, 6000);
      });
    }

    dots.forEach(dot => {
      dot.addEventListener('click', function() {
        goToSlide(parseInt(this.dataset.slide));
        clearInterval(autoplayTimer);
        autoplayTimer = setInterval(nextSlide, 6000);
      });
    });

    autoplayTimer = setInterval(nextSlide, 6000);

    /* Concern filter pill switcher */
    const concernPills = document.querySelectorAll('.vaidyam-concern-pill');
    concernPills.forEach(pill => {
      pill.addEventListener('click', function() {
        concernPills.forEach(p => p.classList.remove('active'));
        this.classList.add('active');
      });
    });
  });
</script>

