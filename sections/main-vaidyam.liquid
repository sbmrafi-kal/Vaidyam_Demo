{% comment %}
  sections/main-vaidyam.liquid — Standalone Editorial Architecture
  Vaidyam: A Journal on Evolving Ayurveda
  BEM Architectural Sections:
  1. Hero: .v-hero, .v-book
  2. Philosophy: .v-philosophy
  3. Care Pathways: .v-carepaths
  4. 18 Columns: .v-columns
  5. CARE Case Monograph: .v-monograph
  6. Video Stage: .v-video
  7. Editorial Board: .v-board
  8. Testimonials: .v-testimonials
  9. Historical Archives: .v-archives
  10. Subscription: .v-subscribe
  11. Double Spread Modal: .v-modal
{% endcomment %}

{{ 'vaidyam-landing.css' | asset_url | stylesheet_tag }}
{%- render 'vaidyam-font' -%}

<div class="v-editorial-universe">

  <!-- ================= 1. HERO BROADHEADER WITH DIABETES BUMPER COVER ================= -->
  <section class="v-hero" id="hero">
    <div class="page-width vaidyam-container">
      <div class="v-hero__grid">
        
        <!-- Left Column: Editorial Callout -->
        <div class="v-hero__content">
          <div class="v-hero__badge">
            <span>Special Bumper Edition • Diabetes &amp; Metabolism</span>
          </div>

          <h1 class="v-hero__title">
            The Peer-Reviewed Voice of <span class="v-hero__title-italic">Evolving Ayurveda.</span>
          </h1>

          <p class="v-hero__lead">
            Bridging classical Sanskrit treatises with modern clinical validation. Published quarterly by Kerala Ayurveda Limited since 2003 — featuring physician-reviewed monographs, CARE-compliant case trials, and clinical casuistry.
          </p>

          <!-- Current Issue Lead Feature Box -->
          <div class="v-hero__highlight">
            <div class="v-hero__highlight-header">
              <span>CURRENT ISSUE LEAD FEATURE</span>
              <span>VOL. VIII • ISSUE 4</span>
            </div>
            <h2 class="v-hero__highlight-title">
              Multidisciplinary Management of Diabetes, Endocrine Srotas &amp; Metabolic Endotoxemia
            </h2>
            <div class="v-hero__highlight-grid">
              <div>✦ <strong>Triphala &amp; SCFA:</strong> Gut-Metabolic Synergy</div>
              <div>✦ <strong>Murivenna:</strong> Acute Sports Trauma Care</div>
              <div>✦ <strong>Śāstramathanam:</strong> Dr. K. Rajagopalan Papers</div>
              <div>✦ <strong>Vancouver Bibliography:</strong> Audited Citations</div>
            </div>
          </div>

          <!-- Action CTAs -->
          <div class="v-hero__ctas">
            <a href="#subscribe-plan" class="v-hero__btn-primary">
              <span>Get Single Issue (₹700) / Annual (₹1,200)</span>
              <span class="v-hero__cta-arrow">→</span>
            </a>
            <button onclick="toggleModal('look-inside-modal', true)" type="button" class="v-hero__btn-secondary">
              <svg class="v-hero__btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
