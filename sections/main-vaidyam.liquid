    const pNum = document.getElementById('prev-num');
    const pTitle = document.getElementById('prev-title');
    const pTag = document.getElementById('prev-tag');
    const pDesc = document.getElementById('prev-desc');
    const pRead = document.getElementById('prev-read');
    const pAuthor = document.getElementById('prev-author');
    const pFormat = document.getElementById('prev-format');

    if (pNum) pNum.innerText = num;
    if (pTitle) pTitle.innerText = title;
    if (pTag) pTag.innerText = tag;
    if (pDesc) pDesc.innerText = desc;
    if (pRead) pRead.innerText = read;
    if (pAuthor) pAuthor.innerText = author;
    if (pFormat) pFormat.innerText = format;

    document.querySelectorAll('.folio-entry').forEach(entry => entry.classList.remove('active'));
    if (event && event.currentTarget) {
      event.currentTarget.classList.add('active');
    }
  }

  // 2. Video Player Embed Controller
  function playJournalVideo() {
    const container = document.getElementById('video-embed-frame');
    const iframe = document.getElementById('video-player-iframe');
    const btn = document.getElementById('video-play-btn');
    const poster = document.getElementById('video-poster-img');

    if (iframe) iframe.src = "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?autoplay=1&rel=0";
    if (container) container.classList.remove('hidden');
    if (btn) btn.classList.add('hidden');
    if (poster) poster.classList.add('hidden');
  }

  // 3. Modal Toggle Controller
  function toggleModal(modalId, show) {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    if (show) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }
</script>

